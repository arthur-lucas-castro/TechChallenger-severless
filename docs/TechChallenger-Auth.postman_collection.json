{
  "info": {
    "name": "TechChallenger - Autenticação (Lambda)",
    "description": "Testes de ponta a ponta da Lambda de autenticação pelo API Gateway.\n\nAntes de rodar: preencha a variável admSenha da coleção. Rode com o Collection Runner, na ordem. Os tokens são salvos sozinhos nas variáveis da coleção. Use delay de 300 ms: as rotas /auth* têm limite de 5 req/s.\n\nA pasta 06 apaga o cliente de teste. Não pule essa pasta: enquanto ele existir, o smoke test do deploy cria uma sessão real a cada execução.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://81459mqote.execute-api.us-east-1.amazonaws.com"
    },
    {
      "key": "admEmail",
      "value": "adm@oficina.com"
    },
    {
      "key": "admSenha",
      "value": "",
      "type": "secret"
    },
    {
      "key": "cpfTeste",
      "value": "12345678909"
    },
    {
      "key": "cpfNaoCadastrado",
      "value": "98765432100"
    },
    {
      "key": "admToken",
      "value": ""
    },
    {
      "key": "clienteToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "refreshAntigo",
      "value": ""
    },
    {
      "key": "clienteId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Erros de validação",
      "item": [
        {
          "name": "CPF inválido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpf\": \"123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Código CPF_INVALIDO', () => pm.expect(pm.response.json().code).to.eql('CPF_INVALIDO'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Body sem CPF",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Código REQUISICAO_INVALIDA', () => pm.expect(pm.response.json().code).to.eql('REQUISICAO_INVALIDA'));"
                ]
              }
            }
          ]
        },
        {
          "name": "CPF sem cadastro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpf\": \"{{cpfNaoCadastrado}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Um 503 aqui indica problema de acesso ao RDS ou ao SSM."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "pm.test('Código CLIENTE_NAO_ENCONTRADO', () => pm.expect(pm.response.json().code).to.eql('CLIENTE_NAO_ENCONTRADO'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Login de Adm",
      "item": [
        {
          "name": "Senha errada",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admEmail}}\",\n  \"senha\": \"senha-errada\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('Código CREDENCIAIS_INVALIDAS', () => pm.expect(pm.response.json().code).to.eql('CREDENCIAIS_INVALIDAS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admEmail}}\",\n  \"senha\": \"{{admSenha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Devolve o par de tokens', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.refreshToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.tokenType).to.eql('Bearer');",
                  "});",
                  "pm.collectionVariables.set('admToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "API aceita o token da Lambda",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/Peca",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Um 401 indica que o segredo do SSM difere do Jwt__SecretKey da API, ou que iss/aud não conferem."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Login de cliente",
      "item": [
        {
          "name": "Cadastrar cliente de teste",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/Cliente",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Teste\",\n  \"sobrenome\": \"Ficticio\",\n  \"telefone\": \"11999999999\",\n  \"email\": \"teste@exemplo.com\",\n  \"numeroDocumento\": \"{{cpfTeste}}\",\n  \"tipoPessoa\": \"F\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('clienteId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login por CPF",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpf\": \"{{cpfTeste}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Devolve o par de tokens', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.refreshToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.tokenType).to.eql('Bearer');",
                  "});",
                  "pm.collectionVariables.set('clienteToken', pm.response.json().accessToken);",
                  "pm.collectionVariables.set('refreshToken', pm.response.json().refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cliente não acessa rota interna",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/Peca",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clienteToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Só passa com a branch feat/autenticacao-via-lambda da API no ar. Um 200 significa que qualquer cliente acessa as rotas internas."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - Rotação e reuso do refresh token",
      "item": [
        {
          "name": "Renovar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/refresh",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Devolve o par de tokens', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.refreshToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.tokenType).to.eql('Bearer');",
                  "});",
                  "pm.test('Devolve um refresh token diferente', () => pm.expect(pm.response.json().refreshToken).to.not.eql(pm.collectionVariables.get('refreshToken')));",
                  "pm.collectionVariables.set('refreshAntigo', pm.collectionVariables.get('refreshToken'));",
                  "pm.collectionVariables.set('refreshToken', pm.response.json().refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Reutilizar o token antigo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/refresh",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshAntigo}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('Código REFRESH_TOKEN_INVALIDO', () => pm.expect(pm.response.json().code).to.eql('REFRESH_TOKEN_INVALIDO'));"
                ]
              }
            }
          ]
        },
        {
          "name": "O token novo também caiu",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/refresh",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Prova que o reuso revogou a sessão inteira."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('Código REFRESH_TOKEN_INVALIDO', () => pm.expect(pm.response.json().code).to.eql('REFRESH_TOKEN_INVALIDO'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 - Logout",
      "item": [
        {
          "name": "Novo login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cpf\": \"{{cpfTeste}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('refreshToken', pm.response.json().refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/logout",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Token não vale depois do logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/refresh",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('Código REFRESH_TOKEN_INVALIDO', () => pm.expect(pm.response.json().code).to.eql('REFRESH_TOKEN_INVALIDO'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "06 - Limpeza",
      "item": [
        {
          "name": "Apagar cliente de teste",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/Cliente/{{clienteId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "O access token de Adm vale 15 minutos. Se expirar, repita o login da pasta 02."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
